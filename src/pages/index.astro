---
import { CommunityJourney } from "@/components/community-journey"
import { FaqSection } from "@/components/faq-section"
import { HeroActions } from "@/components/hero-actions"
import { ThemeToggle } from "@/components/theme-toggle"
import { FeaturesBento } from "@/components/ui/features-bento"
import { Header } from "@/components/ui/header-2"
import { Separator } from "@/components/ui/separator"
import { WorkspaceMockup } from "@/components/workspace-mockup"
import "@/index.css"

const deployUrl =
  "https://deploy.workers.cloudflare.com/?url=https%3A%2F%2Fgithub.com%2FHQBase%2Fhqbase%2Ftree%2Fdeploy"
const sourceUrl = "https://github.com/HQBase/hqbase"
const discordUrl = "https://discord.gg/U67PB663nf"
const pageTitle = "HQBase - your team's email on Cloudflare"
const pageDescription =
  "HQBase gives your team email on your Cloudflare infrastructure, with shared mailboxes, team access, and workflows running in your account."
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#fafafa" />
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href="https://hqbase.io/" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="HQBase" />
    <meta property="og:title" content={pageTitle} />
    <meta
      property="og:description"
      content="Shared mailboxes, team access, and email workflows running on your Cloudflare infrastructure."
    />
    <meta property="og:url" content="https://hqbase.io/" />
    <meta name="twitter:card" content="summary" />
    <title>{pageTitle}</title>
    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-Z2FRK5MFMR"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-Z2FRK5MFMR');
    </script>
    <script is:inline src="/theme.js"></script>
    <script is:inline src="/reveal.js" defer></script>
    <link
      rel="preload"
      href="/fonts/Geist-Regular.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/Geist-SemiBold.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body class="landing-page">
    <a class="skip-link" href="#main">Skip to content</a>
    <Header client:load />
    <main id="main">
      <section class="hero" aria-labelledby="hero-title">
        <div class="page-shell hero-shell">
          <div class="hero-copy" data-reveal="up">
            <h1 class="hero-title" id="hero-title">
              Your team&apos;s email.
              <span>On your Cloudflare infrastructure.</span>
            </h1>
            <p class="hero-principles">Free. Open source. Self-hosted. Unlimited seats.</p>
            <HeroActions client:load />
          </div>
          <WorkspaceMockup client:load />
        </div>
      </section>
      <FeaturesBento />
      <CommunityJourney />
      <FaqSection client:load />
    </main>
    <footer class="site-footer">
      <div class="page-shell" data-reveal="up">
        <Separator />
        <div class="footer-content">
          <div class="footer-brand">
            <a class="brand" href="/" aria-label="HQBase home">
              <img class="brand-logo" src="/logo.svg" alt="" width="168" height="132" />
              <span>HQBase</span>
            </a>
            <p>
              Your team&apos;s email, on your infrastructure. Free software under
              AGPL-3.0-only.
            </p>
          </div>
          <div class="footer-actions">
            <nav class="footer-links" aria-label="Footer">
              <a href="#features">Features</a>
              <a href="#faq">FAQ</a>
              <a href="/docs/">Docs</a>
              <a href={sourceUrl}>GitHub</a>
              <a href={discordUrl}>Discord</a>
              <a href={deployUrl}>Deploy</a>
            </nav>
            <ThemeToggle client:load className="footer-theme-toggle" />
          </div>
        </div>
      </div>
    </footer>
  </body>
</html>
