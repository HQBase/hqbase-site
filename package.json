{
  "name": "hqbase-site",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev --host 127.0.0.1 --port 8791",
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro check && ASTRO_TELEMETRY_DISABLED=1 astro build",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview --host 127.0.0.1 --port 8791",
    "test": "node --test",
    "test:docs": "node scripts/check-docs.mjs",
    "deploy:dry-run": "wrangler deploy --dry-run",
    "check": "pnpm test && pnpm test:docs && pnpm build && pnpm deploy:dry-run",
    "deploy": "pnpm build && wrangler deploy"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.25.0",
    "radix-ui": "^1.6.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/react": "^5.0.4",
    "@astrojs/starlight": "^0.39.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "astro": "^6.3.1",
    "shadcn": "^4.15.0",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2",
    "wrangler": "4.114.0"
  }
}
